  organizationId String?
  source         String
  path           String?
  referrer       String?
  campaign       Json?
  entityId       String?
  privacyClass   String
  properties     Json?
  createdAt      DateTime @default(now())

  @@index([eventName, occurredAt])
  @@index([source, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([userId, occurredAt])
}

model ProjectWorkspaceState {
  id            String                 @id @default(cuid())
  projectId     String                 @unique
  organizationId String
  status        ProjectWorkspaceStatus  @default(DRAFT)
  priority      String                 @default("normal")
  ownerUserId   String?
  startDate     DateTime?
  targetDate    DateTime?
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
}

model WorkspaceAssessment {
  id              String                    @id @default(cuid())
  projectId       String
  organizationId  String
  assessmentId    String                    @unique
  type            String
  objective       String                    @db.Text
  scope           Json
  methodology     String                    @db.Text
  status          WorkspaceAssessmentStatus @default(PLANNED)
  resultStatus    WorkspaceResultStatus     @default(NOT_ASSESSED)
  assessorUserId  String?
  version         String                    @default("1.0")
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  @@index([organizationId, projectId, status])
  @@index([projectId, createdAt])
  @@index([assessmentId])
}

model WorkspaceAssessmentResult {
  id             String   @id @default(cuid())
  assessmentId   String   @unique
  organizationId String
  projectId      String
  requestId      String
  status         String
  result         Json
  resultHash     String
  createdAt      DateTime @default(now())
  @@index([organizationId, projectId, createdAt])
}

model WorkspaceFinding {
  id               String                  @id @default(cuid())
  organizationId   String
  projectId        String
  assessmentId     String
  title            String
  description      String                  @db.Text
  category         String
  severity         WorkspaceFindingSeverity
  likelihood       String?
  impact           String?
  riskScore        Decimal?                @db.Decimal(8, 3)
  riskMethodology  String?
  status           WorkspaceFindingStatus   @default(DRAFT_INTERNAL)
  affectedAsset    String?
  recommendation   String                  @db.Text
  ownerUserId      String?
  dueDate          DateTime?
  visibility       WorkspaceVisibility      @default(TINLANCE_INTERNAL)
  authorship       AIAuthorship             @default(HUMAN_AUTHORED)
  idempotencyKey   String?                 @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  @@index([organizationId, projectId, status])
  @@index([projectId, severity, status])
  @@index([assessmentId, createdAt])
}

model WorkspaceEvidence {
  id               String                  @id @default(cuid())
  organizationId   String
  projectId        String
  assessmentId     String?
  title            String
  description      String?                 @db.Text
  type              String
  source            String
  collectedAt      DateTime
  collectedByUserId String?
  contentHash      String
  hashAlgorithm    String                  @default("SHA-256")
  mimeType         String
  sizeBytes        BigInt
  storageReference String
  classification   WorkspaceVisibility     @default(CUSTOMER_CONFIDENTIAL)
  integrityStatus  EvidenceIntegrityStatus @default(PENDING)
  visibility       WorkspaceVisibility      @default(CUSTOMER_CONFIDENTIAL)
  versionNumber    Int                     @default(1)
  idempotencyKey   String?                 @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  @@index([organizationId, projectId, createdAt])
  @@index([projectId, classification, visibility])
  @@index([assessmentId, createdAt])
  @@index([contentHash])
}

model WorkspaceFindingEvidence {
  findingId   String
  evidenceId  String
  createdAt   DateTime @default(now())
  @@id([findingId, evidenceId])
  @@index([evidenceId])
}

model WorkspaceReport {
  id               String                @id @default(cuid())
  organizationId   String
  projectId        String
  assessmentId     String?
  title            String
  type              String
  currentVersion   Int                   @default(1)
  status           WorkspaceReportStatus @default(DRAFT)
  summary          String?               @db.Text
  generatedAt      DateTime?
  publishedAt      DateTime?
  publishedByUserId String?
  contentHash      String?
  idempotencyKey   String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  @@index([organizationId, projectId, status])
  @@index([projectId, createdAt])
}

model WorkspaceReportVersion {
  id            String   @id @default(cuid())
  reportId      String
  version       Int
  content       String   @db.Text
  contentHash   String
  createdByUserId String
  createdAt     DateTime @default(now())
  @@unique([reportId, version])
  @@index([reportId, createdAt])
}

model WorkspaceRemediation {
  id                 String                    @id @default(cuid())
  organizationId     String
  projectId          String
  findingId          String
  title              String
  description        String                    @db.Text
  ownerUserId        String?
  priority           String
  status             WorkspaceRemediationStatus @default(OPEN)
  targetDate         DateTime?
  completedAt        DateTime?
  verificationStatus VerificationResult        @default(INCONCLUSIVE)
  idempotencyKey     String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  @@index([organizationId, projectId, status])
  @@index([findingId, status])
  @@index([ownerUserId, status, targetDate])
}

model WorkspaceRemediationEvidence {
  remediationId String
  evidenceId    String
  createdAt     DateTime @default(now())
  @@id([remediationId, evidenceId])
  @@index([evidenceId])
}

model WorkspaceVerification {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  findingId      String
  remediationId  String?
  verifierUserId String
  method         String
  result         VerificationResult
  notes          String?            @db.Text
  evidenceId     String?
  createdAt      DateTime           @default(now())
  @@index([organizationId, projectId, createdAt])
  @@index([findingId, createdAt])
  @@index([remediationId, createdAt])
}

model WorkspaceEvidenceRequest {
  id             String               @id @default(cuid())
  organizationId String
  projectId      String
  assessmentId   String?
  title          String
  description    String               @db.Text
  requestedType  String
  dueDate        DateTime?
  requestedByUserId String
  status         EvidenceRequestStatus @default(REQUESTED)
  submittedEvidenceId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  @@index([organizationId, projectId, status])
  @@index([projectId, dueDate])
}

model WorkspaceNote {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  resourceType   String
  resourceId     String
  authorUserId   String
  kind           WorkspaceNoteKind
  body           String            @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@index([organizationId, projectId, kind, createdAt])
  @@index([resourceType, resourceId, createdAt])
}
