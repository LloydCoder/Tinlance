model OrganizationSecurityPolicy {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  requireMfaForPrivileged Boolean @default(true)
  requireSso            Boolean @default(false)
  sessionMaxMinutes     Int      @default(10080)
  idleTimeoutMinutes    Int      @default(1440)
  stepUpTtlSeconds      Int      @default(900)
  breakGlassEnabled     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId])
  @@map("organizationSecurityPolicy")
}

model StepUpChallenge {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  sessionId      String
  method         String
  nonceHash      String    @unique
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  verifiedAt     DateTime?
  ipHash         String?
  userAgentHash  String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, userId, createdAt])
  @@index([sessionId, expiresAt])
  @@map("stepUpChallenge")
}

model BreakGlassGrant {
  id               String    @id @default(cuid())
  organizationId   String
  grantedToUserId  String
  approvedByUserId String
  reason           String
  scope            Json
  ticketReference  String?
  startsAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([organizationId, grantedToUserId, expiresAt])
  @@index([organizationId, expiresAt])
  @@map("breakGlassGrant")
}

model PrivilegeElevation {
  id               String    @id @default(cuid())
  organizationId   String
  userId           String
  requestedRole    String
  scope            Json
  reason           String
  approvedByUserId String?
  startsAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([organizationId, userId, expiresAt])
  @@index([organizationId, expiresAt])
  @@map("privilegeElevation")
}

model AccessReview {
  id             String    @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         String    @default("open")
  initiatedBy    String
  dueAt          DateTime
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, status, dueAt])
  @@map("accessReview")
}

model AccessReviewItem {
  id             String    @id @default(cuid())
  reviewId       String
  organizationId String
  userId         String
  resourceType   String
  resourceId     String
  currentRole    String
  decision       String    @default("pending")
  decidedBy      String?
  decidedAt      DateTime?
  reason         String?

  @@unique([reviewId, userId, resourceType, resourceId])
  @@index([organizationId, decision])
  @@map("accessReviewItem")
}

model ServiceIdentity {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyId          String    @unique
  secretHash     String
  scopes         Json
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, revokedAt])
  @@map("serviceIdentity")
}

model SecurityAuditEvent {
  id                  String   @id @default(cuid())
  organizationId      String?
  actorUserId         String?
  actorServiceId      String?
  action              String
  targetType          String?
  targetId            String?
  requestId           String?
  ipHash              String?
  userAgentHash       String?
  metadata            Json?
  createdAt            DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("securityAuditEvent")
}
