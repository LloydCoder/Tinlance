# Local development defaults
FDE_ENV=development
FDE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FDE_ENABLE_DOCS=false

# Inbound Tinlance -> FDE API authentication
FDE_SERVICE_TOKEN=replace-with-a-long-random-secret

# Canonical FDE Mastery upstream base URL. The gateway calls:
# /v1/{domain}/execute
FDE_MASTER_UPSTREAM_URL=https://fde-mastery.example.internal

# Required production upstream authentication (OAuth 2.0 client credentials)
FDE_OAUTH_TOKEN_URL=https://identity.example.internal/oauth/token
FDE_OAUTH_CLIENT_ID=replace-me
FDE_OAUTH_CLIENT_SECRET=replace-me
FDE_OAUTH_AUDIENCE=https://fde-mastery.example.internal

# Development/test compatibility fallback only. Never configure this in production.
# FDE_MASTER_UPSTREAM_TOKEN=replace-me
