{
  "name": "tinlance",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --filter @tinlance/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
