{
  "name": "tinlance",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @tinlance/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "pnpm audit --audit-level=high"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4",
      "js-yaml": ">=4.3.2",
      "postcss": ">=8.5.18",
      "deepmerge-ts": ">=8.0.0"
    }
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  }
}
