{
  "name": "tinlance",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @tinlance/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18",
      "deepmerge-ts": ">=8.0.0"
    }
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3"
  }
}
